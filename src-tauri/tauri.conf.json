{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "图学基础教程习题解答",
  "version": "0.3.1",
  "identifier": "com.timemaster.tuxue",
  "build": {
    "frontendDist": "../site"
  },
  "app": {
    "windows": [
      {
        "title": "图学基础教程习题解答",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
